#include <iostream>

#include <vector>

struct Student
{
    std::string studentName{};

    std::string rollNumber{};

    std::vector<std::string> subjectsEnrolled;

    std::vector<int> subjectMarks;

    float cgpa{};

}

void printStudent(const Student& s)

{
    std::cout << "Name: " << s.studentName << std::endl;
    std::cout << "Roll Number: " << s.rollNumber << std::endl;
    std::cout << "CGPA: " << s.cgpa << std::endl;

    std::cout << "Subjects: ";
    for (const std::string& subject : s.subjectsEnrolled)
        std::cout << subject << " ";
    std::cout << std::endl;
   

    std::cout << "Marks: ";
    for (int mark : s.subjectMarks)
        std::cout << mark << " ";
    std::cout << std::endl;

  
};


int main()

{
    Student harryPotter = { "Harry Potter", "4587" };

    harryPotter.subjectsEnrolled = { "Quidditch", "Potions", "Herbology","Charms" };

    harryPotter.subjectMarks = { 10, 7, 8, 6 };

    harryPotter.cgpa = 7.75;

    printStudent(harryPotter);


    Student hermioneGranger = { "Hermione Granger", "3712" };
    hermioneGranger.subjectsEnrolled = { "Defence Againts Dark Arts", "Astronomy", "Transfiguration", "Charms" };
    hermioneGranger.subjectMarks = { 10, 8, 9, 10 };
    hermioneGranger.cgpa = 9.25;

    printStudent(hermioneGranger);

    return 0;

} 
